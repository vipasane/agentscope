#!/bin/bash
#
# Commit message validation
# Enforces conventional commit format with quality checks
#

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")
FIRST_LINE=$(echo "$COMMIT_MSG" | head -1)
BODY=$(echo "$COMMIT_MSG" | tail -n +3)

# ============================================
# FORMAT VALIDATION
# ============================================

# Conventional commit pattern: type(scope): subject (max 72 chars)
PATTERN="^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert)(\(.+\))?: .{1,72}$"

if ! [[ "$FIRST_LINE" =~ $PATTERN ]]; then
    echo ""
    echo -e "${RED}❌ Invalid commit message format!${NC}"
    echo ""
    echo -e "${BOLD}Expected format:${NC} <type>(<scope>): <subject>"
    echo ""
    echo -e "${BOLD}Types:${NC}"
    echo "  feat     - New feature"
    echo "  fix      - Bug fix"
    echo "  docs     - Documentation only"
    echo "  style    - Formatting, no code change"
    echo "  refactor - Code change, no new feature or fix"
    echo "  test     - Adding tests"
    echo "  chore    - Maintenance tasks"
    echo "  perf     - Performance improvement"
    echo "  ci       - CI/CD changes"
    echo "  build    - Build system changes"
    echo "  revert   - Reverting a commit"
    echo ""
    echo -e "${BOLD}Good examples:${NC}"
    echo "  feat(scanner): add TypeScript parser support"
    echo "  fix(cli): handle missing config file gracefully"
    echo "  docs(readme): add installation instructions"
    echo "  refactor(types): simplify AgentRef interface"
    echo ""
    echo -e "${BOLD}Your message:${NC} $FIRST_LINE"
    echo ""

    # Provide specific feedback
    if [[ ${#FIRST_LINE} -gt 72 ]]; then
        echo -e "${YELLOW}Issue: Subject line too long (${#FIRST_LINE} > 72 chars)${NC}"
    fi
    if ! [[ "$FIRST_LINE" =~ ^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert) ]]; then
        echo -e "${YELLOW}Issue: Missing or invalid type prefix${NC}"
    fi
    if ! [[ "$FIRST_LINE" =~ :[[:space:]] ]]; then
        echo -e "${YELLOW}Issue: Missing colon and space after type/scope${NC}"
    fi
    echo ""
    exit 1
fi

# ============================================
# QUALITY CHECKS
# ============================================

# Extract type and check for scope
TYPE=$(echo "$FIRST_LINE" | sed -E 's/^([a-z]+).*/\1/')
HAS_SCOPE=false
if [[ "$FIRST_LINE" =~ \(.+\): ]]; then
    HAS_SCOPE=true
    SCOPE=$(echo "$FIRST_LINE" | sed -E 's/^[a-z]+\(([^)]+)\).*/\1/')
fi

# Get staged file info for context
STAGED_COUNT=$(git diff --cached --name-only 2>/dev/null | wc -l | tr -d ' ')
LINES_CHANGED=$(git diff --cached --numstat 2>/dev/null | awk '{sum+=$1+$2} END {print sum+0}')

WARNINGS=""

# Check 1: Multi-file changes should have scope
if [ "$STAGED_COUNT" -gt 3 ] && [ "$HAS_SCOPE" = false ]; then
    WARNINGS+="  • Consider adding a scope for multi-file changes (${STAGED_COUNT} files)\n"
fi

# Check 2: Large changes should have a body explaining "why"
if [ "$LINES_CHANGED" -gt 100 ] && [ -z "$BODY" ]; then
    WARNINGS+="  • Large change (${LINES_CHANGED} lines) - add a body explaining WHY\n"
fi

# Check 3: Subject should be imperative ("add" not "added")
SUBJECT=$(echo "$FIRST_LINE" | sed -E 's/^[^:]+: //')
if [[ "$SUBJECT" =~ ^(added|fixed|updated|changed|removed|created) ]]; then
    WARNINGS+="  • Use imperative mood: 'add' not 'added', 'fix' not 'fixed'\n"
fi

# Check 4: Subject should start with lowercase
FIRST_WORD=$(echo "$SUBJECT" | awk '{print $1}')
if [[ "$FIRST_WORD" =~ ^[A-Z] ]]; then
    WARNINGS+="  • Subject should start with lowercase letter\n"
fi

# Check 5: No period at end of subject
if [[ "$FIRST_LINE" =~ \.$ ]]; then
    WARNINGS+="  • Remove period from end of subject line\n"
fi

# ============================================
# OUTPUT RESULTS
# ============================================

if [ -n "$WARNINGS" ]; then
    echo ""
    echo -e "${YELLOW}⚠️  Commit message suggestions:${NC}"
    echo -e "$WARNINGS"
    echo -e "${CYAN}These are recommendations, not blockers.${NC}"
    echo ""
fi

# ============================================
# HELPFUL BODY TEMPLATE
# ============================================

# If large change without body, show template
if [ "$LINES_CHANGED" -gt 100 ] && [ -z "$BODY" ]; then
    echo -e "${BOLD}Suggested body format for large changes:${NC}"
    echo ""
    echo "  Why: [explain the motivation]"
    echo ""
    echo "  What:"
    echo "  - [bullet point changes]"
    echo ""
    echo "  Testing:"
    echo "  - [how it was tested]"
    echo ""
fi

echo -e "${GREEN}✅ Commit message format valid${NC}"
echo -e "   Type: ${CYAN}$TYPE${NC}"
if [ "$HAS_SCOPE" = true ]; then
    echo -e "   Scope: ${CYAN}$SCOPE${NC}"
fi
echo ""
exit 0
