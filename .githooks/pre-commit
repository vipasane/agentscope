#!/bin/bash
#
# Pre-commit hook - secrets check + change size enforcement
# Encourages small, focused commits with good documentation
#

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

REPO_ROOT=$(git rev-parse --show-toplevel)
IGNORE_FILE="$REPO_ROOT/.secretsignore"

# ============================================
# CHANGE SIZE THRESHOLDS
# ============================================
MAX_FILES_SOFT=5       # Warning threshold
MAX_FILES_HARD=10      # Block threshold (override with --no-verify)
MAX_LINES_SOFT=200     # Warning threshold
MAX_LINES_HARD=500     # Block threshold

# Get staged files
STAGED=$(git diff --cached --name-only)
STAGED_COUNT=$(echo "$STAGED" | grep -c .)

if [ -z "$STAGED" ] || [ "$STAGED_COUNT" -eq 0 ]; then
    exit 0
fi

# Calculate lines changed
LINES_ADDED=$(git diff --cached --numstat | awk '{sum+=$1} END {print sum+0}')
LINES_DELETED=$(git diff --cached --numstat | awk '{sum+=$2} END {print sum+0}')
LINES_TOTAL=$((LINES_ADDED + LINES_DELETED))

# ============================================
# COMMIT SUMMARY
# ============================================
echo ""
echo -e "${BOLD}📋 Commit Summary${NC}"
echo "─────────────────────────────────────────"
echo -e "  Files staged:  ${CYAN}$STAGED_COUNT${NC}"
echo -e "  Lines added:   ${GREEN}+$LINES_ADDED${NC}"
echo -e "  Lines deleted: ${RED}-$LINES_DELETED${NC}"
echo -e "  Total changes: ${BOLD}$LINES_TOTAL${NC}"
echo ""

# Show files being committed (truncated if many)
if [ "$STAGED_COUNT" -le 8 ]; then
    echo -e "${BOLD}Files:${NC}"
    echo "$STAGED" | sed 's/^/  /'
else
    echo -e "${BOLD}Files:${NC} (showing first 5 of $STAGED_COUNT)"
    echo "$STAGED" | head -5 | sed 's/^/  /'
    echo "  ..."
fi
echo ""

# ============================================
# SIZE CHECKS
# ============================================
SIZE_ISSUES=0

# Check file count
if [ "$STAGED_COUNT" -gt "$MAX_FILES_HARD" ]; then
    echo -e "${RED}❌ Too many files in one commit: $STAGED_COUNT files (max: $MAX_FILES_HARD)${NC}"
    echo ""
    echo -e "${YELLOW}This commit touches too many files. Please split it:${NC}"
    echo "  1. git reset HEAD (unstage all)"
    echo "  2. Stage related files together: git add <related-files>"
    echo "  3. Commit with focused scope: git commit"
    echo "  4. Repeat for remaining changes"
    echo ""
    echo -e "${CYAN}Tip: Group by feature, bug fix, or area of code.${NC}"
    echo -e "${CYAN}Use --no-verify only if this is truly a single atomic change.${NC}"
    echo ""
    SIZE_ISSUES=1
elif [ "$STAGED_COUNT" -gt "$MAX_FILES_SOFT" ]; then
    echo -e "${YELLOW}⚠️  Large commit: $STAGED_COUNT files (recommended: ≤$MAX_FILES_SOFT)${NC}"
    echo -e "${CYAN}   Consider: Can this be split into smaller, focused commits?${NC}"
    echo ""
fi

# Check line count
if [ "$LINES_TOTAL" -gt "$MAX_LINES_HARD" ]; then
    echo -e "${RED}❌ Too many lines changed: $LINES_TOTAL lines (max: $MAX_LINES_HARD)${NC}"
    echo ""
    echo -e "${YELLOW}This commit has too many changes. Consider:${NC}"
    echo "  • Split into logical chunks (one feature/fix per commit)"
    echo "  • Separate refactoring from feature changes"
    echo "  • Move large file additions to separate commits"
    echo ""
    SIZE_ISSUES=1
elif [ "$LINES_TOTAL" -gt "$MAX_LINES_SOFT" ]; then
    echo -e "${YELLOW}⚠️  Large commit: $LINES_TOTAL lines (recommended: ≤$MAX_LINES_SOFT)${NC}"
    echo -e "${CYAN}   Consider: Is all of this one logical change?${NC}"
    echo ""
fi

# ============================================
# SECRETS CHECK
# ============================================

# Secret patterns to detect
SECRET_PATTERNS="(sk-ant-|ghp_|AKIA[0-9A-Z]{16}|password\s*=\s*['\"][^'\"]+['\"]|api[_-]?key\s*=\s*['\"][^'\"]+['\"])"

# Load exclusions from .secretsignore
EXCLUDED_FILES=()
EXCLUDED_PATTERNS=()
EXCLUDED_CONTEXTS=()

if [ -f "$IGNORE_FILE" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        [[ "$line" =~ ^#.*$ || -z "$line" ]] && continue
        if [[ "$line" =~ ^PATTERN: ]]; then
            EXCLUDED_PATTERNS+=("${line#PATTERN:}")
        elif [[ "$line" =~ ^CONTEXT: ]]; then
            EXCLUDED_CONTEXTS+=("${line#CONTEXT:}")
        else
            EXCLUDED_FILES+=("$line")
        fi
    done < "$IGNORE_FILE"
fi

is_file_excluded() {
    local file="$1"
    for pattern in "${EXCLUDED_FILES[@]}"; do
        if [[ "$file" == $pattern ]]; then return 0; fi
        if [[ "$file" =~ ^${pattern//\*/.*}$ ]]; then return 0; fi
    done
    return 1
}

is_line_excluded() {
    local line="$1"
    for pattern in "${EXCLUDED_PATTERNS[@]}"; do
        if [[ "$line" == *"$pattern"* ]]; then return 0; fi
    done
    for context in "${EXCLUDED_CONTEXTS[@]}"; do
        if [[ "$line" == *"$context"* ]]; then return 0; fi
    done
    return 1
}

# Check each staged file
FILTERED_SECRETS=""
EXCLUDED_COUNT=0

for file in $STAGED; do
    if is_file_excluded "$file"; then continue; fi
    FILE_SECRETS=$(git diff --cached -- "$file" | grep -iE "^\+.*$SECRET_PATTERNS" || true)
    if [ -n "$FILE_SECRETS" ]; then
        while IFS= read -r line; do
            if is_line_excluded "$line"; then
                ((EXCLUDED_COUNT++))
            else
                FILTERED_SECRETS+="$file: $line"$'\n'
            fi
        done <<< "$FILE_SECRETS"
    fi
done

# Report secrets
if [ -n "$FILTERED_SECRETS" ]; then
    echo -e "${RED}❌ Potential secrets detected in staged changes!${NC}"
    echo ""
    echo "$FILTERED_SECRETS" | head -10
    echo ""
    if [ $EXCLUDED_COUNT -gt 0 ]; then
        echo -e "${CYAN}ℹ️  $EXCLUDED_COUNT matches excluded via .secretsignore${NC}"
    fi
    echo -e "${YELLOW}Add to .secretsignore if this is a known false positive.${NC}"
    exit 1
fi

# ============================================
# FINAL RESULT
# ============================================
if [ "$SIZE_ISSUES" -eq 1 ]; then
    echo -e "${RED}❌ Commit blocked due to size.${NC}"
    echo -e "${YELLOW}   Use 'git commit --no-verify' to bypass (use sparingly).${NC}"
    exit 1
fi

echo -e "${GREEN}✅ Pre-commit checks passed${NC}"
if [ $EXCLUDED_COUNT -gt 0 ]; then
    echo -e "   ${CYAN}($EXCLUDED_COUNT known patterns excluded from secrets check)${NC}"
fi
exit 0
