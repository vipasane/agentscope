#!/bin/bash
#
# prepare-commit-msg hook - Proactive branching guidance
# Helps create multiple small PRs during long coding sessions
#

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# Skip for merge commits, amend, etc.
if [ "$COMMIT_SOURCE" = "merge" ] || [ "$COMMIT_SOURCE" = "squash" ]; then
    exit 0
fi

# ============================================
# CHECK CURRENT BRANCH SIZE
# ============================================

# Thresholds for suggesting new branch
BRANCH_FILES_THRESHOLD=8
BRANCH_LINES_THRESHOLD=300

# Determine base branch
BASE_BRANCH="main"
if ! git rev-parse --verify "$BASE_BRANCH" >/dev/null 2>&1; then
    BASE_BRANCH="master"
fi

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Don't check on main/master
if [ "$CURRENT_BRANCH" = "main" ] || [ "$CURRENT_BRANCH" = "master" ]; then
    exit 0
fi

MERGE_BASE=$(git merge-base "$BASE_BRANCH" HEAD 2>/dev/null || echo "")

if [ -z "$MERGE_BASE" ]; then
    exit 0
fi

# Calculate current branch size (committed + staged)
COMMITTED_FILES=$(git diff --name-only "$MERGE_BASE"..HEAD 2>/dev/null | grep -c . || echo 0)
STAGED_FILES=$(git diff --cached --name-only | grep -c . || echo 0)
TOTAL_FILES=$((COMMITTED_FILES + STAGED_FILES))

COMMITTED_LINES=$(git diff --numstat "$MERGE_BASE"..HEAD 2>/dev/null | awk '{sum+=$1+$2} END {print sum+0}')
STAGED_LINES=$(git diff --cached --numstat | awk '{sum+=$1+$2} END {print sum+0}')
TOTAL_LINES=$((COMMITTED_LINES + STAGED_LINES))

COMMIT_COUNT=$(git rev-list --count "$MERGE_BASE"..HEAD 2>/dev/null || echo 0)

# ============================================
# SUGGEST NEW BRANCH IF GETTING LARGE
# ============================================

if [ "$TOTAL_FILES" -gt "$BRANCH_FILES_THRESHOLD" ] || [ "$TOTAL_LINES" -gt "$BRANCH_LINES_THRESHOLD" ]; then
    echo "" >&2
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}" >&2
    echo -e "${BOLD}💡 Consider starting a new branch${NC}" >&2
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}" >&2
    echo "" >&2
    echo -e "Current branch ${CYAN}$CURRENT_BRANCH${NC} is getting large:" >&2
    echo -e "  • ${CYAN}$TOTAL_FILES${NC} files changed (threshold: $BRANCH_FILES_THRESHOLD)" >&2
    echo -e "  • ${CYAN}$TOTAL_LINES${NC} lines changed (threshold: $BRANCH_LINES_THRESHOLD)" >&2
    echo -e "  • ${CYAN}$COMMIT_COUNT${NC} commits" >&2
    echo "" >&2

    # Suggest next branch name
    NEXT_NUM=2
    if [[ "$CURRENT_BRANCH" =~ -part-([0-9]+)$ ]]; then
        CURRENT_NUM="${BASH_REMATCH[1]}"
        NEXT_NUM=$((CURRENT_NUM + 1))
        NEXT_BRANCH="${CURRENT_BRANCH%-part-*}-part-$NEXT_NUM"
    else
        NEXT_BRANCH="${CURRENT_BRANCH}-part-2"
    fi

    echo -e "${BOLD}After this commit, consider:${NC}" >&2
    echo "" >&2
    echo -e "  ${GREEN}# Push current branch and create PR${NC}" >&2
    echo "  git push -u origin $CURRENT_BRANCH" >&2
    echo "  gh pr create --fill --base $BASE_BRANCH" >&2
    echo "" >&2
    echo -e "  ${GREEN}# Start new branch for next chunk${NC}" >&2
    echo "  git checkout -b $NEXT_BRANCH" >&2
    echo "" >&2
    echo -e "${CYAN}This creates stacked PRs - each small and reviewable!${NC}" >&2
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}" >&2
    echo "" >&2
fi

# ============================================
# SHOW PROGRESS TRACKER
# ============================================

# Only show if we have some commits
if [ "$COMMIT_COUNT" -gt 0 ]; then
    echo "" >&2
    echo -e "${BOLD}📈 Session Progress${NC}" >&2
    echo "─────────────────────" >&2
    echo -e "  Branch: ${CYAN}$CURRENT_BRANCH${NC}" >&2
    echo -e "  Commits: ${CYAN}$COMMIT_COUNT${NC} (+1 pending)" >&2
    echo -e "  Files: ${CYAN}$TOTAL_FILES${NC}" >&2
    echo -e "  Lines: ${CYAN}$TOTAL_LINES${NC}" >&2

    # Visual progress bar
    PROGRESS=$((TOTAL_LINES * 100 / BRANCH_LINES_THRESHOLD))
    if [ "$PROGRESS" -gt 100 ]; then PROGRESS=100; fi
    BAR_FILLED=$((PROGRESS / 5))
    BAR_EMPTY=$((20 - BAR_FILLED))

    FILL=""
    EMPTY=""
    for ((i=0; i<BAR_FILLED; i++)); do FILL+="█"; done
    for ((i=0; i<BAR_EMPTY; i++)); do EMPTY+="░"; done

    if [ "$PROGRESS" -lt 70 ]; then
        COLOR=$GREEN
    elif [ "$PROGRESS" -lt 90 ]; then
        COLOR=$YELLOW
    else
        COLOR=$RED
    fi

    echo -e "  Branch size: [${COLOR}${FILL}${NC}${EMPTY}] ${PROGRESS}%" >&2
    echo "" >&2
fi

exit 0
