#!/bin/bash
#
# Pre-push hook - PR size checks and quality gates
# Encourages small, focused PRs that are easy to review
#

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# ============================================
# PR SIZE THRESHOLDS
# ============================================
MAX_FILES_SOFT=10      # Warning threshold
MAX_FILES_HARD=25      # Block threshold
MAX_LINES_SOFT=400     # Warning threshold
MAX_LINES_HARD=1000    # Block threshold
MAX_COMMITS_SOFT=5     # Warning threshold

REMOTE=$1
URL=$2

echo ""
echo -e "${BOLD}🚀 Pre-push Checks${NC}"
echo "─────────────────────────────────────────"

# ============================================
# BLOCK DIRECT PUSH TO MAIN
# ============================================
while read local_ref local_sha remote_ref remote_sha; do
    if [[ "$remote_ref" == *"refs/heads/main"* ]] || [[ "$remote_ref" == *"refs/heads/master"* ]]; then
        echo -e "${RED}❌ Direct push to main/master is not allowed!${NC}"
        echo ""
        echo "Please create a pull request instead:"
        echo "  1. Push to a feature branch: git push origin HEAD:feat/your-feature"
        echo "  2. Create PR: gh pr create"
        echo ""
        exit 1
    fi
done

# ============================================
# CALCULATE BRANCH DIFF FROM MAIN
# ============================================

# Determine base branch
BASE_BRANCH="main"
if ! git rev-parse --verify "$BASE_BRANCH" >/dev/null 2>&1; then
    BASE_BRANCH="master"
fi
if ! git rev-parse --verify "$BASE_BRANCH" >/dev/null 2>&1; then
    echo -e "${YELLOW}⚠️  Cannot determine base branch for comparison${NC}"
    BASE_BRANCH=""
fi

if [ -n "$BASE_BRANCH" ]; then
    # Get merge base
    MERGE_BASE=$(git merge-base "$BASE_BRANCH" HEAD 2>/dev/null || echo "")

    if [ -n "$MERGE_BASE" ]; then
        # Calculate total diff stats
        FILES_CHANGED=$(git diff --name-only "$MERGE_BASE"..HEAD | grep -c . || echo 0)
        LINES_ADDED=$(git diff --numstat "$MERGE_BASE"..HEAD | awk '{sum+=$1} END {print sum+0}')
        LINES_DELETED=$(git diff --numstat "$MERGE_BASE"..HEAD | awk '{sum+=$2} END {print sum+0}')
        LINES_TOTAL=$((LINES_ADDED + LINES_DELETED))
        COMMIT_COUNT=$(git rev-list --count "$MERGE_BASE"..HEAD 2>/dev/null || echo 0)

        # ============================================
        # PR SUMMARY
        # ============================================
        echo ""
        echo -e "${BOLD}📊 Branch Summary (vs $BASE_BRANCH)${NC}"
        echo "─────────────────────────────────────────"
        echo -e "  Commits:       ${CYAN}$COMMIT_COUNT${NC}"
        echo -e "  Files changed: ${CYAN}$FILES_CHANGED${NC}"
        echo -e "  Lines added:   ${GREEN}+$LINES_ADDED${NC}"
        echo -e "  Lines deleted: ${RED}-$LINES_DELETED${NC}"
        echo -e "  Total changes: ${BOLD}$LINES_TOTAL${NC}"
        echo ""

        # Show changed files (truncated)
        if [ "$FILES_CHANGED" -gt 0 ]; then
            echo -e "${BOLD}Changed files:${NC}"
            if [ "$FILES_CHANGED" -le 10 ]; then
                git diff --name-only "$MERGE_BASE"..HEAD | sed 's/^/  /'
            else
                git diff --name-only "$MERGE_BASE"..HEAD | head -8 | sed 's/^/  /'
                echo "  ... and $((FILES_CHANGED - 8)) more"
            fi
            echo ""
        fi

        # ============================================
        # SIZE CHECKS
        # ============================================
        ISSUES=0
        WARNINGS=0

        # Check file count
        if [ "$FILES_CHANGED" -gt "$MAX_FILES_HARD" ]; then
            echo -e "${RED}❌ PR too large: $FILES_CHANGED files (max: $MAX_FILES_HARD)${NC}"
            ISSUES=1
        elif [ "$FILES_CHANGED" -gt "$MAX_FILES_SOFT" ]; then
            echo -e "${YELLOW}⚠️  Large PR: $FILES_CHANGED files (recommended: ≤$MAX_FILES_SOFT)${NC}"
            WARNINGS=1
        fi

        # Check line count
        if [ "$LINES_TOTAL" -gt "$MAX_LINES_HARD" ]; then
            echo -e "${RED}❌ PR too large: $LINES_TOTAL lines (max: $MAX_LINES_HARD)${NC}"
            ISSUES=1
        elif [ "$LINES_TOTAL" -gt "$MAX_LINES_SOFT" ]; then
            echo -e "${YELLOW}⚠️  Large PR: $LINES_TOTAL lines (recommended: ≤$MAX_LINES_SOFT)${NC}"
            WARNINGS=1
        fi

        # Check commit count
        if [ "$COMMIT_COUNT" -gt "$MAX_COMMITS_SOFT" ]; then
            echo -e "${YELLOW}⚠️  Many commits: $COMMIT_COUNT (consider squashing related commits)${NC}"
            WARNINGS=1
        fi

        # ============================================
        # SPLITTING GUIDANCE
        # ============================================
        if [ "$ISSUES" -eq 1 ]; then
            echo ""
            echo -e "${BOLD}How to split this into smaller PRs:${NC}"
            echo ""
            echo "  1. Identify logical groupings:"
            git diff --name-only "$MERGE_BASE"..HEAD | sed 's|/.*||' | sort | uniq -c | sort -rn | head -5 | while read count dir; do
                echo "     - $dir/ ($count files)"
            done
            echo ""
            echo "  2. Create stacked PRs:"
            echo "     git checkout -b feat/part-1 $BASE_BRANCH"
            echo "     git cherry-pick <commits-for-part-1>"
            echo "     git push && gh pr create --base $BASE_BRANCH"
            echo ""
            echo "     git checkout -b feat/part-2 feat/part-1"
            echo "     git cherry-pick <commits-for-part-2>"
            echo "     git push && gh pr create --base feat/part-1"
            echo ""
            echo -e "${CYAN}Tip: Reviewers prefer 200-400 line PRs. Split by:${NC}"
            echo "  • Feature vs refactoring vs tests"
            echo "  • Independent components or modules"
            echo "  • Setup/infrastructure vs business logic"
            echo ""
            echo -e "${YELLOW}Use --no-verify to bypass (not recommended for large PRs)${NC}"
            exit 1
        fi

        if [ "$WARNINGS" -eq 1 ]; then
            echo ""
            echo -e "${CYAN}Consider splitting into smaller PRs for easier review.${NC}"
            echo ""
        fi
    fi
fi

# ============================================
# RUN TESTS IF AVAILABLE
# ============================================
if [ -f "package.json" ] && grep -q '"test"' package.json 2>/dev/null; then
    echo -e "${BOLD}Running tests...${NC}"
    if npm test 2>/dev/null; then
        echo -e "${GREEN}✓ Tests passed${NC}"
    else
        echo -e "${RED}❌ Tests failed. Push aborted.${NC}"
        exit 1
    fi
    echo ""
fi

# ============================================
# SUCCESS
# ============================================
echo -e "${GREEN}✅ Pre-push checks passed${NC}"
echo ""

# Remind about PR creation
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$CURRENT_BRANCH" != "main" ] && [ "$CURRENT_BRANCH" != "master" ]; then
    echo -e "${CYAN}After push, create PR with:${NC}"
    echo "  gh pr create --fill"
    echo ""
fi

exit 0
