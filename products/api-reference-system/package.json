{
  "name": "@claude-flow/api-reference-system",
  "version": "1.0.0",
  "description": "Automated API documentation generation system with TypeScript parsing, multi-format output, and neural learning",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "api-docs": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "gen:docs": "node dist/cli.js generate",
    "gen:watch": "node dist/cli.js watch"
  },
  "keywords": [
    "documentation",
    "api-docs",
    "typescript",
    "tsdoc",
    "code-generation",
    "vector-search",
    "hnsw",
    "neural-learning"
  ],
  "author": "Claude Flow Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@microsoft/tsdoc": "^0.15.0",
    "@tsconfig/node20": "^20.1.4",
    "chokidar": "^3.6.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.5",
    "glob": "^10.3.10",
    "marked": "^12.0.0",
    "shiki": "^1.0.0",
    "typescript": "^5.6.2",
    "vitepress": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.2.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
