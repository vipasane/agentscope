# Alpha Feedback System - Environment Variables

# === API Configuration ===
API_TITLE="Alpha Feedback System API"
API_VERSION="1.0.0"

# === GitHub Integration ===
GITHUB_TOKEN="your_github_token_here"
GITHUB_OWNER="ruvnet"
GITHUB_WEBHOOK_SECRET="your_webhook_secret_here"

# === AI Models (Optional - will use defaults) ===
SENTIMENT_MODEL="distilbert-base-uncased-finetuned-sst-2-english"
CLASSIFIER_MODEL="facebook/bart-large-mnli"
EMBEDDINGS_MODEL="sentence-transformers/all-mpnet-base-v2"

# === Vector Store ===
VECTOR_STORE_PATH="./data/vector_store"
HNSW_M=16
HNSW_EF_CONSTRUCTION=200
HNSW_EF_SEARCH=50

# === Rate Limiting ===
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_GLOBAL=1000

# === GDPR ===
CONSENT_RETENTION_DAYS=730
DATA_DELETION_GRACE_DAYS=30

# === Security (Optional) ===
SECRET_KEY="your_secret_key_here_change_in_production"
CORS_ORIGINS="*"

# === Database (Optional - uses in-memory by default) ===
# DATABASE_URL="postgresql+asyncpg://user:password@localhost/feedback_db"

# === Redis (Optional - for caching) ===
# REDIS_URL="redis://localhost:6379/0"
