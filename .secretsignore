# Secret Detection Exclusions
# =========================
# This file lists patterns to exclude from secret detection.
#
# Supported formats:
# - File paths (glob patterns): docs/**/*.md
# - Line patterns (regex): /sk-ant-.*/ (detection pattern in docs)
# - Context patterns: ^#.*sk-ant (commented lines)
#
# Add entries below, one per line. Lines starting with # are comments.

# Documentation files containing regex examples
# These contain detection patterns, not actual secrets
docs/architecture/SECURITY-ARCHITECTURE.md
docs/architecture/v2-roadmap/SECURITY-ARCHITECTURE.md
docs/architecture/v2-roadmap/*.md
.claude/skills/**/*.md
docs/PRD-*.md
docs/products/*.md
docs/reviews/*.md
docs/packages/*.md
docs/research/*.md

# Security package - contains regex patterns for secret detection
packages/security/**/*.md
packages/security/**/*.ts

# Regex patterns that look like secrets but are detection patterns
# Format: PATTERN:<regex> - matches lines containing these as part of a larger regex
PATTERN:/sk-ant-
PATTERN:/ghp_
PATTERN:grep.*sk-ant
PATTERN:sed.*sk-ant
PATTERN:regex.*sk-ant
PATTERN:SECRET_PATTERNS=

# Context: Lines that are clearly examples or placeholders
CONTEXT:EXAMPLE_
CONTEXT:example_api_key
CONTEXT:your-api-key-here
CONTEXT:<your-.*-key>

# Test fixtures (if any)
# tests/fixtures/**/*
# JSDoc documentation examples (anti-patterns showing what NOT to do)
docs/api/interfaces/types.SecurityFinding.html
packages/testing/src/helpers/setup-helpers.ts
tests/jsdoc-integration.test.ts
# ADR-023 contains regex patterns for secret detection (not actual secrets)
docs/adr/ADR-023*.md
docs/adr/ADR-023-security-package-architecture.md
docs/adr/ADR-023*.md

# Security package benchmarks contain test data with example secrets
# These are intentional fixtures for testing secret detection
packages/security/benchmarks/**.test.ts
packages/security/benchmarks/**.md
docs/research/*.md
