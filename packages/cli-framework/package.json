{
  "name": "@vipasane/agentscope-cli-framework",
  "version": "0.1.0-alpha.1",
  "description": "Zero-dependency CLI framework for consistent command patterns and rapid CLI development",
  "license": "MIT",
  "author": "AgentScope Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vipasane/agentscope.git",
    "directory": "packages/cli-framework"
  },
  "bugs": {
    "url": "https://github.com/vipasane/agentscope/issues"
  },
  "homepage": "https://github.com/vipasane/agentscope/tree/main/packages/cli-framework#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cli",
    "framework",
    "command-line",
    "argument-parser",
    "interactive",
    "terminal",
    "console",
    "zero-dependencies",
    "agentscope"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:tests": "tsc -p tsconfig.test.json",
    "dev": "tsc --watch",
    "test": "npm run build && npm run build:tests && node --test dist-test/tests/**/*.test.js",
    "test:watch": "npm run build:tests && node --test --watch dist-test/tests/**/*.test.js",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist dist-test",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.30",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
