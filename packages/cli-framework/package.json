{
  "name": "@claude-flow/cli-framework",
  "version": "1.0.0",
  "description": "Zero-dependency CLI framework for consistent command patterns and rapid CLI development",
  "license": "MIT",
  "author": "Claude Flow Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/claude-flow.git",
    "directory": "packages/cli-framework"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/claude-flow/issues"
  },
  "homepage": "https://github.com/ruvnet/claude-flow/tree/main/packages/cli-framework#readme",
  "keywords": [
