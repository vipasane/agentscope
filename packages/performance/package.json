{
  "name": "@vipasane/agentscope-performance",
  "version": "0.1.0-alpha.1",
  "description": "Performance optimization utilities for claude-flow - monitoring, caching, batching, profiling",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "npm run bench:all",
    "bench:all": "node --experimental-specifier-resolution=node dist/benchmarks/run-benchmarks.js",
    "bench:quantization": "vitest run benchmarks/quantization.test.ts",
    "bench:hnsw": "vitest run benchmarks/optimization/hnsw.bench.ts",
    "bench:stress": "vitest run benchmarks/stress/stress-test.bench.ts",
    "bench:integration": "vitest run tests/integration/multi-layer-integration.test.ts",
    "validate-targets": "node dist/scripts/validate-performance-targets.js",
    "lint": "eslint src tests --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "performance",
    "optimization",
    "caching",
    "monitoring",
    "profiling",
    "claude-flow"
  ],
  "author": "Claude Flow Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vipasane/agentscope.git",
    "directory": "packages/performance"
  },
  "bugs": {
    "url": "https://github.com/vipasane/agentscope/issues"
  },
  "homepage": "https://github.com/vipasane/agentscope/tree/main/packages/performance#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0",
    "@vitest/coverage-v8": "^1.2.0"
  },
  "peerDependencies": {
    "@vipasane/agentscope-memory": "^3.0.0-alpha.1"
  },
  "peerDependenciesMeta": {
    "@vipasane/agentscope-memory": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
