{
  "name": "@vipasane/agentscope-memory",
  "version": "3.0.0-alpha.1",
  "description": "Unified vector database interface with AgentDB HNSW indexing and quantized storage",
  "license": "MIT",
  "author": "Claude Flow Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/claude-flow.git",
    "directory": "packages/memory"
  },
  "keywords": [
    "vector-database",
    "agentdb",
    "hnsw",
    "quantization",
    "memory",
    "embeddings",
    "semantic-search",
    "ai-memory"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./store": {
      "import": "./dist/store/index.js",
      "types": "./dist/store/index.d.ts"
    },
    "./vector": {
      "import": "./dist/vector/index.js",
      "types": "./dist/vector/index.d.ts"
    },
    "./cache": {
      "import": "./dist/cache/index.js",
      "types": "./dist/cache/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && tsc --project tsconfig.cjs.json",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {},
  "peerDependenciesMeta": {
    "@vipasane/agentscope-security": {
      "optional": true
    }
  }
}
