{
  "name": "@vipasane/agentscope-learning",
  "version": "1.2.0",
  "description": "ReasoningBank adaptive learning with 4-step pipeline (RETRIEVE-JUDGE-DISTILL-CONSOLIDATE) for continuous improvement through pattern recognition and EWC++ forgetting prevention",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "ARCHITECTURE.md",
    "API-DESIGN.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "benchmark": "vitest bench",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "npm run clean && npm run build && npm run test"
  },
  "keywords": [
    "ai",
    "agent",
    "learning",
    "reasoningbank",
    "adaptive",
    "ewc",
    "pattern-recognition",
    "trajectory-tracking",
    "verdict-judgment",
    "memory-distillation",
    "catastrophic-forgetting",
    "hnsw",
    "vector-search",
    "agentscope",
    "machine-learning",
    "reinforcement-learning",
    "continual-learning"
  ],
  "author": "AgentScope Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vipasane/agentscope.git",
    "directory": "packages/learning"
  },
  "bugs": {
    "url": "https://github.com/vipasane/agentscope/issues"
  },
  "homepage": "https://github.com/vipasane/agentscope/tree/main/packages/learning#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.2.0",
    "eslint": "^8.56.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "peerDependencies": {},
  "engines": {
    "node": ">=20.0.0"
  }
}
