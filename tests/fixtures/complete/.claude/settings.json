{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "echo pre-edit",
            "timeout": 5000,
            "continueOnError": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "echo post-edit",
            "timeout": 5000,
            "continueOnError": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo session started",
            "timeout": 5000,
            "continueOnError": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "echo 'status'",
    "refreshMs": 5000,
    "enabled": true
  },
  "permissions": {
    "allow": ["Bash(npm:*)"],
    "deny": ["Bash(rm -rf /*)"]
  },
  "customConfig": {
    "enabled": true,
    "maxAgents": 10
  }
}
