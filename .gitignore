# ===========================================
# Claude Flow - Runtime & Generated Files
# ===========================================

# Claude Flow data directory (memory, sessions, patterns)
.claude-flow/

# Claude Flow memory database
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Claude Flow daemon files
.claude-flow-daemon.pid
.claude-flow-daemon.log
daemon.log
daemon.pid

# Claude Flow session state
.session-state/
sessions/
*.session.json

# Claude Flow neural patterns & training data
neural-patterns/
*.onnx
*.weights
*.model
training-data/

# Claude Flow cache
.cache/
.claude-flow-cache/
embeddings-cache/

# Claude Flow memory exports
memory-export*.json
patterns-export*.json

# ===========================================
# Claude Code - Runtime & Generated Files
# ===========================================

# Claude Code task outputs
.claude-tasks/
task-output*.txt

# Note: .claude/ is tracked for shared hooks and settings
# Exclude only runtime/personal files:
.claude/projects/
.claude/statsig/
.claude/todos/
.claude/*.log

# ===========================================
# MCP (Model Context Protocol) Files
# ===========================================

# MCP server logs
mcp-*.log
.mcp-servers/

# Note: .mcp.json may contain local paths - review before committing
# Uncomment if you want to exclude it:
# .mcp.json

