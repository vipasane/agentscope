    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "agentscope": "file:agentscope-0.1.0.tgz",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
