{
  "name": "@vipasane/agentscope",
  "version": "0.1.0",
  "description": "Agent Architecture Documentation & Visualization Tool - From chaos to clarity",
  "license": "SEE LICENSE FILE",
  "author": "AgentScope Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vipasane/agentscope.git"
  },
  "bugs": {
    "url": "https://github.com/vipasane/agentscope/issues"
  },
  "homepage": "https://github.com/vipasane/agentscope#readme",
  "keywords": [
    "agent",
    "claude",
    "claude-code",
    "mcp",
    "documentation",
    "visualization",
    "mermaid",
    "diagram",
    "cli",
    "theme",
    "accessibility",
    "colorblind",
    "dark-mode"
  ],
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "agentscope": "./dist/src/cli/index.js"
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/src/cli/index.js",
    "test": "vitest run",
